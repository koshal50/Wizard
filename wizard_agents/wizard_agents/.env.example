# LLM provider selection: "mock" (default, no server required) or "vllm" (real runtime)
WIZARD_LLM_PROVIDER=mock

# Required only when WIZARD_LLM_PROVIDER=vllm
# Base URL of your self-hosted vLLM server (OpenAI-compatible API); 8000 is vLLM's default port.
WIZARD_LLM_BASE_URL=http://localhost:8000
# Open-source model served by vLLM (example shown).
WIZARD_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
