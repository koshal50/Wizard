# ─── Wizard Investigation Planner — Environment ───────────────────────────────
#
# The Planner is provider-agnostic. If no provider is configured, Wizard falls
# back to the offline deterministic "heuristic" provider so the full pipeline
# runs end-to-end with NO network and NO API key.

# One of: heuristic | mock | anthropic | openai
LLM_PROVIDER=heuristic

# Model id (provider-specific). Ignored by heuristic/mock.
# LLM_MODEL=claude-opus-4-8

# API keys — only read by the matching provider. NEVER commit real keys.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional overrides
# LLM_BASE_URL=
# LLM_MAX_TOKENS=2048
# LLM_TIMEOUT_MS=60000
