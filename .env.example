CEREBRAS_KEY=your_cerebras_key_here
Wizard_DATABASE_URL=postgresql://username:your_password@localhost:5432/wizard_db

# Optional account website. Local investigations do not require this stack.
# Set to 1 to start the account stack alongside the Runtime, or use wizard /login.
WIZARD_ACCOUNT_AUTOSTART=0
WIZARD_ACCOUNT_URL=http://localhost:3000
WIZARD_ACCOUNT_LOCAL_DEV=1
# Optional website checkout override (default: ../wizar-web/wizardsite).
# WIZARD_WEBSITE_DIR=D:/path/to/wizardsite
