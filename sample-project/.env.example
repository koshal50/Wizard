# Copy to .env and fill in the secrets. The server validates all of these at boot and
# exits with a readable error if something is missing or malformed.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database --------------------------------------------------------------
# Postgres connection string. Ignored when DB_DRIVER is "memory".
DATABASE_URL=postgres://board:board@localhost:5432/board
# "pg" for the real database, "memory" for a throwaway in-process store.
DB_DRIVER=pg

# --- Auth ------------------------------------------------------------------
# Required. Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
# Access token lifetime, in the jsonwebtoken duration format (15m, 1h, 7d).
JWT_EXPIRES_IN=15m
# How many days a stored refresh token stays usable.
REFRESH_TOKEN_TTL_DAYS=30
# bcrypt cost factor. 12 is a reasonable 2024 default; lower it only in tests.
BCRYPT_ROUNDS=12

# --- HTTP ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# morgan format: "dev" while developing, "combined" in production.
LOG_FORMAT=dev
# Login and register rate limiting: attempts per window, per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# --- Client ----------------------------------------------------------------
# Read by Vite at build time, so it must carry the VITE_ prefix to reach the
# browser bundle at all.
VITE_API_URL=http://localhost:4000/api
