# Wizard — repository ignore rules

# Leftover runtime-engine working directory on this branch: virtualenv,
# caches, compiled bytecode, and investigation output. The engine SOURCE
# lives on other branches; on this branch this directory is NOT tracked and
# must never be committed.
wizard-runtime-engine/

# Python bytecode / caches
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Test cache
.pytest_cache/

# Packaging build artifacts
build/
dist/
*.egg-info/

# Runtime investigation output written by the engine
.wizard/

# Local environment / secrets (keep .env.example, ignore the real .env)
.env

# Node dependencies
node_modules/
package*node_modules/

# TypeScript build output
*.tsbuildinfo
